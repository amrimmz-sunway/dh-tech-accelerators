#!/bin/bash
# Generated by branch-split. Splits @@APP@@'s change set into @@COUNT@@ ticket branches.
# Each branch is cut from @@BASE@@ (or from its parent branch) and PR'd into @@TARGET@@.
# It creates each branch and stages its patch, then waits for YOU to review, commit and push.
# It never commits or pushes by itself.
set -euo pipefail

REPO=@@REPO@@
P=@@OUT@@
BASE=@@BASE@@
BASE_SHA=@@BASE_SHA@@
BACKUP=@@BACKUP@@
VERSION_FILES=(@@VERSION_FILES@@)
BRANCHES=(
@@BRANCHES@@
)
cd "$REPO"

# ---- Pre-checks: nothing changes until all of these pass ----
git fetch origin "$BASE"
[ "$(git branch --show-current)" = "$BASE" ] || { echo "Switch to $BASE first."; exit 1; }
git merge-base --is-ancestor HEAD "origin/$BASE" || { echo "$BASE has local commits not on origin. Push or reset them first."; exit 1; }
if [ "$(git rev-parse "origin/$BASE")" != "$BASE_SHA" ]; then
  echo "origin/$BASE moved since the patches were built (built on ${BASE_SHA:0:12})."
  echo "Ask Claude to rebuild the patches; nothing was changed."; exit 1
fi
for entry in "${BRANCHES[@]}"; do
  patch=${entry##*|}
  [ -f "$P/$patch" ] || { echo "Missing patch: $P/$patch"; exit 1; }
done
EXISTING=0
for entry in "${BRANCHES[@]}"; do
  b=${entry%%|*}
  if git rev-parse -q --verify "refs/heads/$b" >/dev/null || git rev-parse -q --verify "refs/remotes/origin/$b" >/dev/null; then
    echo "Already exists: $b"; EXISTING=1
  fi
done
[ "$EXISTING" = 0 ] || { echo "Stopping before any change. Rename or delete the branch(es) above, or ask Claude for a resume script."; exit 1; }

# ---- Back up everything, then go ----
STASHED=0
if git stash list | grep -q "$BACKUP"; then
  STASHED=1
elif [ -n "$(git status --porcelain)" ]; then
  git stash push --include-untracked -m "$BACKUP"; STASHED=1
fi
git merge --ff-only "origin/$BASE"

for entry in "${BRANCHES[@]}"; do
  IFS='|' read -r b parent patch <<<"$entry"
  echo
  echo "=== $b  (from $parent)"
  git switch -c "$b" "$parent"
  git apply --index "$P/$patch"
  git status --short
  while :; do
    read -r -p "Review, commit and push '$b' (git push -u origin \"$b\"), then press Enter... " _
    if ! git diff --cached --quiet || ! git diff --quiet; then
      echo "There are still uncommitted changes on $b. Commit them first."; continue
    fi
    if [ "$(git rev-list --count "$parent..HEAD")" = 0 ]; then
      echo "No commit on $b yet."; continue
    fi
    break
  done
done

echo
echo "All @@COUNT@@ branches done. Back on $BASE."
git switch "$BASE"
if [ "$STASHED" = 1 ]; then
  REF=$(git stash list | grep "$BACKUP" | head -1 | cut -d: -f1)
  if [ "${#VERSION_FILES[@]}" -gt 0 ]; then
    for f in "${VERSION_FILES[@]}"; do
      if git cat-file -e "$REF:$f" 2>/dev/null; then git checkout "$REF" -- "$f" && git reset -q -- "$f"; fi
    done
    echo "Version bump restored (unstaged):"
  fi
  git status --short
  echo
  echo "Full backup kept as $REF ($BACKUP). Drop it after the PRs are merged and tested:"
  echo "  git stash drop $REF"
fi
